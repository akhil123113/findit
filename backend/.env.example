# ------------------------------------------------------------------
# FindIt - Lost & Found Portal : environment configuration
# Copy this file to ".env" and adjust the values.
# ------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/findit
# MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/findit
# Leave it EMPTY to run in "file store" mode - the app then saves all data to
# backend/data/db.json so you can try the project without installing MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/findit

# Secret used to sign JWT session tokens - change this to a long random string
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime in days
JWT_EXPIRES_DAYS=7

# Comma separated list of e-mail addresses that are allowed to register as admin
ADMIN_EMAILS=admin@findit.edu

# If true, newly reported items go live immediately.
# Set to false to force every report through admin approval first.
AUTO_APPROVE_ITEMS=true

# Seed demo users + items the first time the database is empty
SEED_ON_EMPTY=true

# Max upload size in megabytes
MAX_UPLOAD_MB=5

# Set to "production" when deploying (enables secure cookies, hides dev reset links)
NODE_ENV=development
